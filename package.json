{
  "name": "@workspace/aura-crm",
  "version": "0.19.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "node scripts/stamp-sw.mjs && next build --webpack && node scripts/precache-sw.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build:turbo": "node scripts/stamp-sw.mjs && next build && node scripts/precache-sw.mjs",
    "build:dev": "next build --webpack",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:critical": "node --test tests/critical-regressions.test.mjs",
    "test:ios-optimizations": "node --test tests/ios-optimizations.test.mjs",
    "test:offline-startup": "node --test tests/offline-startup.test.mjs",
    "test:logout-protection": "node --experimental-strip-types --test tests/logout-protection.test.mjs",
    "test:lockfile": "node --test tests/lockfile-registry.test.mjs",
    "test:search-loading": "node --test tests/search-loading.test.mjs",
    "test:atomic": "node --test scripts/test-atomic-actions.mjs",
    "test:atomic:postgres": "node scripts/test-atomic-postgres.mjs",
    "test:branches": "node scripts/test-branch-access-postgres.mjs && node --experimental-strip-types --test tests/branch-access.test.mjs",
    "test:history:postgres": "node scripts/test-action-history-postgres.mjs",
    "test:product-units": "node --max-old-space-size=64 scripts/check-product-unit-usage.mjs",
    "test:inventory-revision": "node --experimental-strip-types --test tests/inventory-revision.test.mjs tests/qr-code.test.mjs tests/revision-label-scan.test.mjs tests/revision-routing.test.mjs tests/scanner-overlay.test.mjs",
    "test:reports": "node --experimental-strip-types --test tests/sales-timeline.test.mjs",
    "test:receipt": "node --experimental-strip-types --test tests/receipt-type.test.mjs",
    "test:export": "node --experimental-strip-types --test tests/report-export.test.mjs tests/report-export-xlsx.test.mjs",
    "test:reconciliation": "node --experimental-strip-types --test tests/report-reconciliation.test.mjs",
    "cap:sync": "cap sync && node scripts/sync-ios-icon.mjs",
    "cap:ios": "node scripts/sync-ios-icon.mjs && cap open ios"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor-community/bluetooth-le": "^8.4.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor-mlkit/barcode-scanning": "^8.2.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@vercel/analytics": "1.6.1",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fabric": "^7.4.0",
    "heic2any": "^0.0.4",
    "idb": "^8.0.3",
    "lucide-react": "^1.16.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "niimbot-web-bluetooth": "^2.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^10.15.0",
    "postcss": "^8.5",
    "supabase": "^2.116.0-beta.11",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  },
  "overrides": {
    "hono": "4.13.16",
    "proxy-addr": "2.0.8"
  }
}
